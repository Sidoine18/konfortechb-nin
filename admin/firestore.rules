rules_version = '2';

// =============================================================================
// Règles de sécurité Firestore — KONFORTECH BÉNIN (konfortechbenin-4a084)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // FONCTIONS D'AIDE
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdminRole() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() in ['superadmin', 'editeur', 'commercial', 'technicien'];
    }

    function isSuperAdmin() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() == 'superadmin';
    }

    function canEditContent() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() in ['superadmin', 'editeur'];
    }

    function canManageLeads() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() in ['superadmin', 'commercial'];
    }

    // -------------------------------------------------------------------
    // USERS (Règle corrigée pour l'inscription et la connexion)
    // -------------------------------------------------------------------
    match /users/{userId} {
      // Un utilisateur connecté a le droit de lire SON propre document sans vérifier son rôle
      allow read: if isOwner(userId) || isAdminRole();

      // Inscription : l'utilisateur connecté crée son propre document avec le
      // rôle 'client' forcé, un email qui correspond à son compte Auth, et
      // uniquement les champs attendus (pas de champs arbitraires injectés).
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'client'
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'createdAt']);

      // Modification / Suppression
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
                    || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------
    // CONTENU PUBLIC
    // -------------------------------------------------------------------
    match /projects/{docId} {
      allow read: if resource.data.published == true || canEditContent();
      allow write: if canEditContent();
    }
    match /realisations/{docId} {
      allow read: if resource.data.published == true || canEditContent();
      allow write: if canEditContent();
    }
    match /blog_posts/{docId} {
      allow read: if resource.data.published == true || canEditContent();
      allow write: if canEditContent();
    }
    match /resources/{docId} {
      allow read: if resource.data.published == true || canEditContent();
      allow write: if canEditContent();
    }
    match /partners/{docId} {
      allow read: if resource.data.active == true || canEditContent();
      allow write: if canEditContent();
    }

    // Équipe
    match /team_members/{docId} {
      allow read: if resource.data.active == true || canEditContent();
      allow write: if canEditContent();
    }

    // Contenu de pages uniques
    match /site_content/{docId} {
      allow read: if true;
      allow write: if canEditContent();
    }

    // -------------------------------------------------------------------
    // AVIS CLIENTS
    // -------------------------------------------------------------------
    match /testimonials/{docId} {
      allow read: if resource.data.approved == true || canManageLeads();
      allow create: if request.resource.data.approved == false;
      allow update, delete: if canManageLeads();
    }

    // -------------------------------------------------------------------
    // DEMANDES DE DEVIS
    // -------------------------------------------------------------------
    match /devis_requests/{docId} {
      // Si l'utilisateur est connecté, le clientId doit obligatoirement
      // correspondre à son propre uid (empêche de créer une demande au nom
      // d'un autre utilisateur). Les visiteurs non connectés restent
      // autorisés à soumettre une demande (formulaire public du site).
      allow create: if request.resource.data.status == 'nouveau'
                    && (!isSignedIn() || request.resource.data.clientId == request.auth.uid);
      allow read: if canManageLeads()
                  || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow update: if canManageLeads()
                    || (isSignedIn() && resource.data.clientId == request.auth.uid
                        && request.resource.data.clientId == resource.data.clientId);
      allow delete: if canManageLeads();
    }

    // -------------------------------------------------------------------
    // MESSAGES DE CONTACT
    // -------------------------------------------------------------------
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if canManageLeads();
    }

    // -------------------------------------------------------------------
    // MESSAGERIE CLIENT <-> ADMIN
    // -------------------------------------------------------------------
    match /conversations/{clientId} {
      allow read, write: if isOwner(clientId) || isAdminRole();
      match /messages/{messageId} {
        allow read: if isOwner(clientId) || isAdminRole();
        allow create: if (isOwner(clientId) || isAdminRole())
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdminRole();
      }
    }

    // -------------------------------------------------------------------
    // FACTURES / PAIEMENTS
    // -------------------------------------------------------------------
    match /invoices/{docId} {
      allow read: if isAdminRole() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if isAdminRole();
    }

    // -------------------------------------------------------------------
    // DOCUMENTS PARTAGÉS
    // -------------------------------------------------------------------
    match /client_documents/{docId} {
      allow read: if isAdminRole() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if isAdminRole();
    }

    // -------------------------------------------------------------------
    // NOTIFICATIONS ADMIN
    // -------------------------------------------------------------------
    match /admin_notifications/{docId} {
      allow read, update: if isAdminRole();
      allow create: if true;
      allow delete: if isAdminRole();
    }

    // -------------------------------------------------------------------
    // PARAMÈTRES GLOBAUX
    // -------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Par défaut : tout le reste est bloqué.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
